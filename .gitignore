# --- Roblox / Rojo artifacts ---
# Built place/model files (generated from source). Never commit build output.
/build/
*.rbxlx
*.rbxmx
*.rbxm
*.rbxl.lock

# Rojo sourcemap (generated by `rojo sourcemap`). Never commit.
sourcemap.json

# Rojo local server / plugin state
*.rbxlx.lock
.rojo/

# Roblox Studio local state / autosaves / logs
*.rbxlx.bak
*.rbxl.bak
*.lock
*.log
rbx-storage*
!MysteryCaseRoblox.rbxl

# --- Tooling / editors ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.luau/
luau-analyze.json

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Secrets (never commit) ---
*.env
.env.*
!/.env.example

# Python bytecode from tools/headless
__pycache__/

# Node.js dependencies for tools/headless
node_modules/
package.json
package-lock.json
